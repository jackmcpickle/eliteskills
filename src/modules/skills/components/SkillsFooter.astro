---

---

<footer class="relative py-16 sm:py-24 px-6">
    <!-- Top border -->
    <div
        class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-neon-amber to-transparent"
    >
    </div>

    <div class="max-w-3xl mx-auto text-center">
        <h2
            class="reveal font-display text-3xl sm:text-4xl font-800 text-white tracking-tight mb-4"
        >
            Ready to Level Up?
        </h2>
        <p class="reveal reveal-delay-1 text-mist mb-8 max-w-lg mx-auto">
            Get the full skill pack and transform how your AI writes code.
        </p>
        <div
            class="shimmer reveal reveal-delay-2 group inline-flex max-w-full items-center gap-2 px-4 sm:px-8 py-4 rounded-lg bg-neon-cyan text-void font-mono font-700 text-[11px] sm:text-sm tracking-wide transition-all overflow-x-auto overscroll-x-contain"
        >
            <span class="select-all whitespace-nowrap"
                >npx skills add jackmcpickle/eliteskills</span
            >
        </div>

        <div class="mt-12 sm:mt-20 pt-8 border-t border-border">
            <div
                class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 sm:gap-6"
            >
                <a
                    href="/"
                    class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-[0.22em] text-ghost hover:text-neon-cyan"
                    >Home</a
                >
                <a
                    href="/skills"
                    class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-[0.22em] text-neon-cyan"
                    >Skills</a
                >
                <a
                    href="/about"
                    class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-[0.22em] text-ghost hover:text-neon-cyan"
                    >About</a
                >
                <a
                    href="/contact"
                    class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-[0.22em] text-ghost hover:text-neon-cyan"
                    >Contact</a
                >
                <a
                    href="/llm.txt"
                    class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-[0.22em] text-ghost hover:text-neon-cyan"
                    >LLM</a
                >
            </div>
            <p class="font-mono text-xs text-ghost tracking-wider">
                &copy; {new Date().getFullYear()} Elite Skills &middot; Built by&nbsp;<span
                    class="text-mist">Jack&nbsp;McNicol</span
                >
            </p>
        </div>
    </div>
</footer>
