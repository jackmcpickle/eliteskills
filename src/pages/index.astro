---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
	HeroBanner,
	CompatibleTools,
	SkillsGrid,
	MetricsBar,
	BenefitsSection,
	DifferentiatorSection,
	AiBotSection,
	FooterCta,
	WhatAreSkills,
} from '@/modules/home';

const SITE_URL = 'https://eliteskills.ai';

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Elite Skills',
	url: SITE_URL,
	description: 'Elite AI Skills for vibe coders, founders, and builders. 20 years of engineering distilled into precision-crafted AI instruction sets.',
};
---

<BaseLayout
	title="Elite Skills — AI Skills for Builders"
	description="Elite AI Skills for vibe coders, founders, and builders. 20 years of engineering distilled into precision-crafted AI instruction sets."
	jsonLd={[websiteJsonLd]}
>
	<HeroBanner />
	<WhatAreSkills />
	<SkillsGrid />
	<MetricsBar />
	<BenefitsSection />
	<DifferentiatorSection />
	<CompatibleTools />

	<AiBotSection />
	<FooterCta />

	<script>
		let observer: IntersectionObserver | undefined;
		function bindReveal(): void {
			observer?.disconnect();
			observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							if (entry.target.classList.contains('snake-grid')) {
								const cells = entry.target.querySelectorAll('.snake-cell');
								const cols = window.matchMedia('(min-width: 1024px)').matches ? 3
									: window.matchMedia('(min-width: 640px)').matches ? 2 : 1;
								requestAnimationFrame(() => {
									cells.forEach((cell, i) => {
										const row = Math.floor(i / cols);
										const col = i % cols;
										const order = row * cols + (row % 2 === 0 ? col : cols - 1 - col);
										(cell as HTMLElement).style.setProperty('--snake-order', String(order));
									});
								});
							}
							entry.target.classList.add('in-view');
							observer?.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
			);
			document.querySelectorAll('.scroll-sheen, .scroll-border-trace, .snake-grid').forEach((el) => {
				observer?.observe(el);
			});
		}
		document.addEventListener('astro:page-load', bindReveal);
		bindReveal();
	</script>
</BaseLayout>
